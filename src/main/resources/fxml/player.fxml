<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Button?>


<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="group15.mediaplayer.controller.PlayerController">
    <top>
        <BorderPane>
            <left>
                <VBox spacing="5">
                    <TextArea fx:id="playerDisplay"
                              onMouseClicked="#handlePlayerDisplayClick"
                              prefRowCount="2"
                              prefColumnCount="10"
                              editable="false" />
                </VBox>
            </left>
            <right>
                <BorderPane>
                    <top>
                        <TextField fx:id="playerMeta"
                                   editable="false" />
                    </top>
                    <left>
                        <Slider fx:id="volumeSlider" />
                    </left>
                    <right>
                        <HBox>
                            <Button fx:id="equalizerButton"
                                    text="EQ"/>
                            <Button fx:id="playlistButton"
                                    text="PL"/>

                        </HBox>
                    </right>
                </BorderPane>
            </right>
        </BorderPane>
    </top>
    <center>

    <Slider fx:id="progressSlider"/>
    </center>
    <bottom>
        <BorderPane>
            <left>
                <HBox>
                    <Button fx:id="previousButton"
                            text="⏮"
                            onAction="#handlePreviousAction" />
                    <Button fx:id="playButton"
                            text="▶"
                            onAction="#handlePlayAction" />
                    <Button fx:id="pauseButton"
                            text="⏸"
                            onAction="#handlePauseAction" />
                    <Button fx:id="stopButton"
                            text="⏹"
                            onAction="#handleStopAction" />
                    <Button fx:id="nextButton"
                            text="⏭"
                            onAction="#handleNextAction" />
                </HBox>
            </left>
            <right>
                <HBox>
                    <Button fx:id="shuffleButton"
                            text="🔀"
                            onAction="#handleShuffleAction"/>
                    <Button fx:id="repeatButton"
                            text="🔁"
                            onAction="#handleRepeatAction"/>
                            <!-- 🔂 -->
                </HBox>
            </right>
        </BorderPane>
    </bottom>

</BorderPane>