<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Button?>

<?import javafx.scene.layout.HBox?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="group15.mediaplayer.controller.PlayerController">
    <top>
        <BorderPane>
            <left>
                <TextArea fx:id="playerDisplay"
                          promptText="No song playing..."
                          prefRowCount="2"
                          prefColumnCount="10" />
            </left>
            <right>
                <BorderPane>
                    <top>
                        <TextField fx:id="playerMeta"
                                   promptText="No song playing..." />
                    </top>
                    <left>
                        <Slider fx:id="volumeSlider" />
                    </left>
                    <right>
                        <Button fx:id="equalizerButton" text="EQ"/>
                        <Button fx:id="playlistButton" text="PL"/>
                    </right>
                </BorderPane>
            </right>
        </BorderPane>
    </top>
    <center>
        <Slider fx:id="progressSlider" />
    </center>
    <bottom>
        <BorderPane>
            <left>
                <HBox>
                    <Button fx:id="previousButton" text=" ▐◄"/>
                    <Button fx:id="playButton" text=" ► "/>
                    <Button fx:id="pauseButton" text="▐▐ "/>
                    <Button fx:id="stopButton" text=" ■ "/>
                    <Button fx:id="nextButton" text="►▌ "/>
                </HBox>
            </left>
            <right>
                <HBox>
                    <Button fx:id="shuffleButton" />
                    <Button fx:id="repeatButton" />
                </HBox>
            </right>
        </BorderPane>
    </bottom>
</BorderPane>